# Copy to .env (same folder) and fill in the blanks. .env is git-ignored - never commit it.

# SQL Server 28 / datav2 (source data)
SQL28_PWD=
# Optional - these are the defaults:
# SQL28_SERVER=192.168.151.28
# SQL28_PORT=1433
# SQL28_DATABASE=datav2
# SQL28_USER=ssis_new
# SQL28_DRIVER=ODBC Driver 18 for SQL Server

# Snowflake - site users and login history (tables are created on first use)
SNOWFLAKE_ACCOUNT=A3121383155871-HH80816
SNOWFLAKE_USER=
# Key-pair login (preferred): full path to the .p8 private key, and its passphrase if encrypted
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# ...or a password, used only when no private key is set
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=DATA_PLATFORM_ADMIN
SNOWFLAKE_WAREHOUSE=V2_WH
SNOWFLAKE_DATABASE=V2RETAIL
SNOWFLAKE_SCHEMA=BRONZE

# Site login
# MPOS_SECRET_KEY signs session cookies - any long random string; changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_hex(32))"
MPOS_SECRET_KEY=
# Password of the built-in 'admin' account (whoever knows it is admin). Not stored in Snowflake.
MPOS_ADMIN_PASSWORD=
# MPOS_SESSION_HOURS=8
# Pre-filled temporary password for new users and resets (they must change it at first login)
MPOS_DEFAULT_PASSWORD=

